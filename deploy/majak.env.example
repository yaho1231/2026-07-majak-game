# MAJAK 공개 배포 설정 (샘플)
#
# 이 파일을 같은 폴더의 majak.env로 복사한 뒤 값을 채우세요.
#   cp deploy/majak.env.example deploy/majak.env
# majak.env는 .gitignore에 등록돼 커밋되지 않습니다(SIGNUP_CODE 같은 비밀 보관).
#
# 값은 따옴표 없는 단순 문자열을 권장합니다(공백·특수문자가 있으면 "따옴표"로 감싸세요).

# 서버 포트 — 공유기에서 이 포트를 포워딩한다. 다른 서비스와 겹치지 않게.
PORT=3011

# 가입 게이트 — 이 코드를 아는 사람만 회원가입 가능. 반드시 바꾸세요.
# (비우면 게이트 꺼짐 = 누구나 가입 가능)
SIGNUP_CODE=change-me

# 국 사이 결과 화면 대기 상한(ms). 사람 전원이 닫으면 그전에 다음 국 진행.
INTER_ROUND_DELAY_MS=7000

# (표시용) 공개 도메인 — 시작 시 접속 URL 안내에 쓰입니다. 없으면 생략 가능.
PUBLIC_HOST=gol.n-e.kr

# (선택) 세션 토큰 수명(ms). 비우면 30일.
#SESSION_TTL_MS=

# (선택) 계정·게임 DB 경로. 비우면 replays/majak.db.
#DB_PATH=
