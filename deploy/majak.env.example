# 이능마작 공개 배포 설정 (샘플)
#
# 이 파일을 같은 폴더의 majak.env로 복사한 뒤 값을 채우세요.
#   cp deploy/majak.env.example deploy/majak.env
# majak.env는 .gitignore에 등록돼 커밋되지 않습니다(SIGNUP_CODE 같은 비밀 보관).
#
# 값은 따옴표 없는 단순 문자열을 권장합니다(공백·특수문자가 있으면 "따옴표"로 감싸세요).

# 서버 포트 — 공유기에서 이 포트를 포워딩한다. 다른 서비스와 겹치지 않게.
PORT=3011

# 가입 게이트 — 이 코드를 아는 사람만 회원가입 가능. 반드시 바꾸세요.
# (비우면 게이트 꺼짐 = 누구나 가입 가능)
SIGNUP_CODE=change-me

# 국 사이 결과 화면 대기 상한(ms). 사람 전원이 닫으면 그전에 다음 국 진행.
INTER_ROUND_DELAY_MS=7000

# (표시용) 공개 도메인 — 시작 시 접속 URL 안내에 쓰입니다. 없으면 생략 가능.
PUBLIC_HOST=gol.n-e.kr

# (선택) 관리자 가입 코드를 운영자가 직접 고정한다.
# 비우면 서버가 DB에 코드를 만들어 쓰고, **한 번 쓰이면 곧바로 회전한다**
# (관리자 계정이 이미 있으면 부팅 로그에도 찍지 않는다).
# 설정하면 그 값을 쓰되 DB·로그에 남기지 않는다 — 관리자를 하나 더 만들어야 할 때 쓴다.
# ⚠ 관리자 권한 = 전 계정 조회·삭제 + 모든 리플레이 열람 + 진행 중 대국 관전(전원 손패).
#ADMIN_CODE=

# (선택) 세션 토큰 수명(ms). 비우면 30일.
#SESSION_TTL_MS=

# (선택) 신규 WS 연결 속도 상한 — 같은 IP(IPv6는 /64)에서 10초당 연결 수. 기본 40.
#CONN_RATE_MAX=40

# (선택) 동시 HTTP 소켓 상한(업그레이드 안 한 연결 포함). 기본 512.
#MAX_HTTP_SOCKETS=512

# (선택) 계정·게임 DB 경로. 비우면 replays/majak.db.
#DB_PATH=

# ─────────────── 리버스 프록시 / 공개 배포 (Cloudflare Tunnel) ───────────────

# 바인드 주소. 리버스 프록시(터널)를 앞에 두면 127.0.0.1로 로컬만 노출해
# 평문 포트가 인터넷에 직접 뜨지 않게 한다. 비우면 모든 인터페이스.
HOST=127.0.0.1

# 신뢰 프록시 모드 — 실제 클라이언트 IP를 어디서 읽을지.
#   (비움)      프록시 없음. 소켓 원격주소 사용.
#   cloudflare  Cloudflare가 붙이는 CF-Connecting-IP 사용 (Tunnel 배포 시 필수)
#   xff         X-Forwarded-For 마지막 홉 사용 (nginx/Caddy 등)
# ★ 프록시 뒤에서 이걸 비워두면 모든 접속이 127.0.0.1로 보여
#   IP 기반 방어(연결 상한·요청 제한·무차별대입 차단)가 전원에게 무력화된다.
TRUST_PROXY=cloudflare

# WebSocket 허용 오리진(콤마 구분). 비우면 검사 안 함(로컬·개발).
# 설정하면 목록 밖 사이트에서 연 WS 연결을 거부한다(CSWSH 차단).
ALLOWED_ORIGINS=https://majak.yaho1231.com

# (선택) 하트비트 주기(ms). 기본 30000. 이 주기 안에 pong이 없으면 연결을 끊는다.
#HEARTBEAT_INTERVAL_MS=30000
