# 이능마작 리버스 프록시 (Caddy) — TLS(wss) 종단 예시
#
# 이능마작 서버는 단일 포트에서 HTTP(정적 SPA) + WebSocket을 함께 서빙한다.
# Caddy는 도메인의 인증서를 Let's Encrypt로 자동 발급/갱신하고, HTTP와
# WebSocket 업그레이드를 그대로 프록시한다(별도 설정 불필요).
#
# 사용법:
#   1) `your-domain.example`을 실제 도메인으로 바꾼다 (DuckDNS 등도 가능).
#   2) 라우터에서 80·443 포트를 이 서버로 포워딩한다.
#   3) 이능마작 서버를 PORT=3001로 띄운다 (npm start).
#   4) `caddy run --config deploy/Caddyfile.example`  (또는 시스템 Caddy에 배치)
#
# 클라이언트는 same-origin(wss://your-domain.example)으로 자동 접속하므로
# 추가 클라이언트 설정이 필요 없다.

your-domain.example {
	# 전송 압축. 서버도 스스로 gzip을 하지만(packages/server/src/index.ts), 여기서
	# 한 번 더 선언해 두면 **zstd**를 쓸 수 있는 브라우저에게는 더 작게 나간다.
	# Caddy는 업스트림이 이미 Content-Encoding을 붙여 보낸 응답은 건드리지 않으므로
	# 이중 압축이 되지 않는다.
	#
	# 왜 굳이 양쪽에 두는가: 배포 경로가 둘이다 — Caddy를 쓰는 구성과, Cloudflare
	# Tunnel이 서버로 곧장 붙는 구성. 서버 쪽에만 두면 Caddy 구성에서 zstd를 놓치고,
	# Caddy 쪽에만 두면 터널 구성에서 압축이 통째로 빠진다(실제로 빠져 있었다 —
	# 감사 2026-08-17 §7-2: styles.css 175KB가 원본 그대로 나갔다).
	encode zstd gzip

	# 이능마작 서버(단일 포트). PORT를 바꿨다면 여기 포트도 맞춘다.
	reverse_proxy localhost:3001

	# (선택) 접근 로그
	log {
		output file /var/log/caddy/majak.log
	}
}
