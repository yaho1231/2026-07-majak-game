{
  "name": "@majak/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --sourcemap --outfile=dist/index.mjs --log-level=warning",
    "golden": "node --import tsx/esm src/goldenCli.ts",
    "load": "BOT_THINK_MS=0 AUTO_MOVE_MS=0 node --expose-gc --import tsx/esm src/loadCli.ts",
    "replay": "node --import tsx/esm src/replay.ts",
    "start": "node --import tsx/esm src/index.ts",
    "arena": "node --import tsx/esm src/arenaCli.ts"
  },
  "dependencies": {
    "@majak/core": "*",
    "@majak/content": "*",
    "ws": "^8.18.0",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "*",
    "@types/ws": "^8.5.10"
  }
}
